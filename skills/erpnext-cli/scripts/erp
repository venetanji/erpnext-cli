#!/usr/bin/env python3
"""
erp — a REST-first swiss-army CLI over a running ERPNext/Frappe instance.

Default path is the token-auth REST API (no container, no file copy). The `exec`
subcommand is the escape hatch for genuine server-side python, run through the
bind-mounted scripts dir via the auto-committing bench execute / env python.

  erp ping                                  # who am I / is it up
  erp doctor [--fix] [--quiet]              # background-worker/queue health; --fix restarts dead workers
  erp get <DocType> <name>
  erp list <DocType> [--filters JSON] [--fields JSON] [--order-by S] [--limit N]
  erp count <DocType> [--filters JSON]
  erp report <Name> [--filters JSON]
  erp reconcile <BankAccount> [--from-date D --to-date D --types pe,je,si,pi --exact --limit N]  # preview matcher
  erp schema <DocType> [--all]                      # live field schema (standard + custom fields)
  erp doctypes [--custom] [--module M]              # discover doctypes (e.g. custom ones)
  erp insert <DocType> --json '{...}' [--unique '[["bill_no","=","X"]]']
  erp set-value <DocType> <name> <field> <value>
  erp submit|cancel|delete <DocType> <name>
  erp method <dotted.path> [--json '{...}']         # any whitelisted method
  erp doc-method <method> <DocType> <name> [--json '{...}']
  erp attach <DocType> <name> <url> [--filename NAME]
  erp add-field <DocType> <fieldname> <fieldtype> [--label L --after F --options O --reqd --unique --read-only --force]
  erp set-prop <DocType> <field> <property> <value> [--type T] [--doctype-prop]   # Property Setter (no code)
  erp import <DocType> <file.{json,jsonl,csv,xlsx}> [--key F --update --submit --limit N --dry-run]  # fast REST loop
  erp data-import <DocType> <file.{csv,xlsx}> [--update --submit --attach-pdf URL --no-wait]          # native engine (mapping+validation+error log)
  erp exec module.function                          # server-side via bench execute (auto-commit)
  erp exec --console file.py                        # ad-hoc bench console script (self-commits)

Extend it: add a `cmd_<name>(args, c)` function and register a subparser in main().
See CONTRIBUTING.md.
"""
import argparse
import json
import sys
from datetime import datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from erpnext_client import ERPNextClient, ERPNextError  # noqa: E402


def _out(obj):
    print(obj if isinstance(obj, str) else json.dumps(obj, indent=2, default=str))


def cmd_ping(args, c):
    user = c.method("frappe.auth.get_logged_user")
    print(f"✓ {c.base} (site {c.site}) — authenticated as {user}")


def cmd_doctor(args, c):
    """background-worker/queue health; --fix restarts workers if none are online (cron-friendly with --quiet)"""
    d = c.doctor()
    if args.fix and not d["healthy"]:
        c.restart_workers()
        d = c.doctor()
        d["fixed"] = True
    if args.quiet:
        ts = datetime.now().isoformat(timespec="seconds")
        extra = " (restarted)" if d.get("fixed") else ""
        sched = " scheduler=DISABLED" if d.get("scheduler_disabled") else ""
        print(f"{ts} workers={d['workers_online']} pending={d['pending_jobs']} "
              f"healthy={d['healthy']}{extra}{sched}")
    else:
        _out(d)
    return 0 if d["healthy"] else 1


def cmd_get(args, c):
    _out(c.get(args.doctype, args.name))


def cmd_list(args, c):
    _out(c.list(args.doctype,
                filters=json.loads(args.filters) if args.filters else None,
                or_filters=json.loads(args.or_filters) if args.or_filters else None,
                fields=json.loads(args.fields) if args.fields else None,
                order_by=args.order_by, limit=args.limit))


def cmd_count(args, c):
    print(c.count(args.doctype, json.loads(args.filters) if args.filters else None))


def cmd_report(args, c):
    _out(c.report(args.name, json.loads(args.filters) if args.filters else None))


def cmd_reconcile(args, c):
    """preview bank-reconciliation matches for unreconciled transactions (read-only)"""
    bts = c.bank_transactions_open(args.bank_account, args.from_date, args.to_date)
    if args.limit:
        bts = bts[:args.limit]
    types = args.types.split(",") if args.types else None
    matched = 0
    for bt in bts:
        amt = bt.get("withdrawal") or bt.get("deposit") or bt.get("unallocated_amount") or 0
        m = c.linked_payments(bt["name"], types=types, from_date=args.from_date,
                              to_date=args.to_date, exact=args.exact)
        if m:
            matched += 1
        flag = "✓" if m else "·"
        print(f"{flag} {bt.get('date')}  {float(amt):>11,.2f}  {(bt.get('description') or '').strip()[:48]}")
        for v in m[:3]:
            vamt = v.get("paid_amount") or v.get("amount") or v.get("outstanding_amount")
            print(f"        → {v.get('doctype')} {v.get('name')}  amt={vamt}  rank={v.get('rank')}")
    print(f"-- {matched}/{len(bts)} open transactions have ≥1 candidate match"
          + (" (exact only)" if args.exact else ""))
    return 0


def cmd_schema(args, c):
    """show a DocType's live field schema (standard + custom fields)"""
    s = c.schema(args.doctype)
    flags = " ".join(k for k in ("custom", "issingle", "istable", "is_submittable") if s.get(k))
    print(f"{s['doctype']}  [module={s['module']}{(' ' + flags) if flags else ''}]  autoname={s['autoname']}")
    skip = {"Section Break", "Column Break", "Tab Break", "HTML", "Heading"}
    for f in s["fields"]:
        if not args.all and f.get("fieldtype") in skip:
            continue
        bits = ("*" if f.get("_custom") else "") + ("!" if f.get("reqd") else "") \
            + ("U" if f.get("unique") else "") + ("R" if f.get("read_only") else "")
        opt = f.get("options") or ""
        if f.get("fieldtype") in ("Link", "Table", "Table MultiSelect"):
            opt = "→ " + str(opt).split("\n")[0]
        elif f.get("fieldtype") == "Select":
            opt = "|".join(x for x in str(opt).split("\n") if x.strip())
        print(f"  {f.get('fieldname',''):30} {f.get('fieldtype',''):18} {bits:4} {opt}")
    print("  (legend: * custom  ! reqd  U unique  R read-only  → link/table target)")


def cmd_doctypes(args, c):
    """list DocTypes — --custom for only customized ones, --module to filter"""
    filters = []
    if args.custom:
        filters.append(["custom", "=", 1])
    if args.module:
        filters.append(["module", "=", args.module])
    rows = c.list("DocType", filters=filters or None,
                  fields=["name", "module", "custom", "issingle", "istable"],
                  order_by="name asc", limit=0)
    for r in rows:
        tags = " ".join(t for t, k in (("custom", "custom"), ("single", "issingle"), ("child", "istable")) if r.get(k))
        print(f"{r['name']:42} {r.get('module',''):22} {tags}")
    print(f"-- {len(rows)} doctypes")


def cmd_insert(args, c):
    doc = json.loads(args.json)
    if args.unique:
        flt = json.loads(args.unique)
        if c.exists(doc["doctype"], flt):
            print(f"↩ skip: {doc['doctype']} matching {flt} already exists (idempotent)")
            return
    _out(c.insert(doc))


def cmd_set_value(args, c):
    _out(c.set_value(args.doctype, args.name, args.field, args.value))


def cmd_submit(args, c):
    _out(c.submit(args.doctype, args.name))


def cmd_cancel(args, c):
    _out(c.cancel(args.doctype, args.name))


def cmd_delete(args, c):
    _out(c.delete(args.doctype, args.name))


def cmd_method(args, c):
    _out(c.method(args.path, **(json.loads(args.json) if args.json else {})))


def cmd_doc_method(args, c):
    _out(c.run_doc_method(args.method, args.doctype, args.name,
                          json.loads(args.json) if args.json else None))


def cmd_attach(args, c):
    _out(c.attach_url(args.doctype, args.name, args.url, args.filename))


def cmd_add_field(args, c):
    """add a Custom Field to a DocType (idempotent; --force updates)"""
    doc = {"doctype": "Custom Field", "dt": args.doctype, "fieldname": args.fieldname,
           "fieldtype": args.fieldtype,
           "label": args.label or args.fieldname.replace("_", " ").title(),
           "insert_after": args.after, "options": args.options,
           "reqd": int(args.reqd), "unique": int(args.unique), "read_only": int(args.read_only)}
    ex = c.list("Custom Field", filters=[["dt", "=", args.doctype], ["fieldname", "=", args.fieldname]],
                fields=["name"], limit=1)
    if ex:
        if not args.force:
            print(f"↩ Custom Field {args.doctype}.{args.fieldname} exists (use --force to update)")
            return
        c.set_value("Custom Field", ex[0]["name"], {k: v for k, v in doc.items() if k != "doctype"})
        print(f"↻ updated {ex[0]['name']}")
    else:
        _out(c.insert(doc))


def cmd_set_prop(args, c):
    """upsert a Property Setter (field-level; --doctype-prop for a doctype-level property)"""
    dof = "DocType" if args.doctype_prop else "DocField"
    flt = [["doc_type", "=", args.doctype], ["property", "=", args.property], ["doctype_or_field", "=", dof]]
    if not args.doctype_prop:
        flt.append(["field_name", "=", args.field])
    ex = c.list("Property Setter", filters=flt, fields=["name"], limit=1)
    if ex:
        c.set_value("Property Setter", ex[0]["name"], {"value": args.value, "property_type": args.type})
        print(f"↻ updated {ex[0]['name']} → {args.value}")
    else:
        _out(c.insert({"doctype": "Property Setter", "doctype_or_field": dof, "doc_type": args.doctype,
                       "field_name": None if args.doctype_prop else args.field,
                       "property": args.property, "property_type": args.type, "value": args.value}))


def cmd_data_import(args, c):
    """native ERPNext Data Import engine for csv/xlsx (column mapping, validation, error log)"""
    _out(c.data_import(args.doctype, args.file,
                       import_type="Update Existing Records" if args.update else "Insert New Records",
                       submit=args.submit, attach_pdf=args.attach_pdf,
                       wait=not args.no_wait))


def cmd_import(args, c):
    """bulk import json/jsonl/csv/xlsx → DocType over REST (each row its own txn).
    --key F: skip/update rows whose F already exists (idempotent re-runs). --dry-run previews."""
    rows = c.read_records(args.file)
    if args.limit:
        rows = rows[:args.limit]
    created = updated = skipped = errors = 0
    for i, raw in enumerate(rows, 1):
        row = {k: v for k, v in raw.items() if v is not None and v != ""}
        row["doctype"] = args.doctype
        try:
            if args.key and row.get(args.key) is not None:
                ex = c.list(args.doctype, filters=[[args.key, "=", row[args.key]]], fields=["name"], limit=1)
                if ex:
                    if args.update and not args.dry_run:
                        c.set_value(args.doctype, ex[0]["name"],
                                    {k: v for k, v in row.items() if k not in ("doctype", args.key)})
                        if args.submit:
                            c.submit(args.doctype, ex[0]["name"])
                    updated += 1 if args.update else 0
                    skipped += 0 if args.update else 1
                    continue
            if args.dry_run:
                created += 1
                continue
            doc = c.insert(row)
            if args.submit:
                c.submit(args.doctype, doc["name"])
            created += 1
        except Exception as e:
            errors += 1
            print(f"  row {i} ERR: {str(e)[:160]}")
        if i % 50 == 0:
            print(f"  …{i}/{len(rows)}  created {created} updated {updated} skipped {skipped} err {errors}", flush=True)
    _out({"file": args.file, "doctype": args.doctype, "rows": len(rows), "created": created,
          "updated": updated, "skipped": skipped, "errors": errors, "dry_run": bool(args.dry_run)})


def cmd_exec(args, c):
    """run server-side python: `erp exec module.function` (bench execute, auto-commit) or `erp exec --console file.py`"""
    mode = "console" if args.console else "execute"
    print(c.exec_script(args.target, mode=mode))


def main():
    p = argparse.ArgumentParser(prog="erp", description="REST-first ERPNext CLI")
    sub = p.add_subparsers(dest="cmd", required=True)

    def add(name, fn, *pos, **opts):
        sp = sub.add_parser(name, help=fn.__doc__)
        for a in pos:
            sp.add_argument(a)
        for flag, kw in opts.items():
            sp.add_argument("--" + flag.replace("_", "-"), **kw)
        sp.set_defaults(_fn=fn)
        return sp

    add("ping", cmd_ping)
    add("doctor", cmd_doctor, fix={"action": "store_true"}, quiet={"action": "store_true"})
    add("get", cmd_get, "doctype", "name")
    add("list", cmd_list, "doctype", filters={}, fields={}, or_filters={},
        order_by={}, limit={"type": int, "default": 20})
    add("count", cmd_count, "doctype", filters={})
    add("report", cmd_report, "name", filters={})
    add("reconcile", cmd_reconcile, "bank_account",
        from_date={}, to_date={}, types={}, exact={"action": "store_true"},
        limit={"type": int, "default": 25})
    add("schema", cmd_schema, "doctype", all={"action": "store_true"})
    add("doctypes", cmd_doctypes, custom={"action": "store_true"}, module={})
    add("insert", cmd_insert, json={"required": True}, unique={})
    add("set-value", cmd_set_value, "doctype", "name", "field", "value")
    add("submit", cmd_submit, "doctype", "name")
    add("cancel", cmd_cancel, "doctype", "name")
    add("delete", cmd_delete, "doctype", "name")
    add("method", cmd_method, "path", json={})
    add("doc-method", cmd_doc_method, "method", "doctype", "name", json={})
    add("attach", cmd_attach, "doctype", "name", "url", filename={})
    add("add-field", cmd_add_field, "doctype", "fieldname", "fieldtype",
        label={}, after={}, options={},
        reqd={"action": "store_true"}, unique={"action": "store_true"},
        read_only={"action": "store_true"}, force={"action": "store_true"})
    add("set-prop", cmd_set_prop, "doctype", "field", "property", "value",
        type={"default": "Data"}, doctype_prop={"action": "store_true"})
    add("import", cmd_import, "doctype", "file",
        key={}, update={"action": "store_true"}, submit={"action": "store_true"},
        limit={"type": int}, dry_run={"action": "store_true"})
    add("data-import", cmd_data_import, "doctype", "file",
        update={"action": "store_true"}, submit={"action": "store_true"},
        attach_pdf={}, no_wait={"action": "store_true"})
    add("exec", cmd_exec, "target", console={"action": "store_true"})

    args = p.parse_args()
    try:
        args._fn(args, ERPNextClient())
    except ERPNextError as e:
        print(f"✗ {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
